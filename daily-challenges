<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Content Copier</title>

    <style>
        .box {
            border: 2px solid blue;
            padding: 20px;
            margin: 15px;
            min-height: 100px;
        }
    </style>
</head>
<body>

    <h1>Content Copier</h1>

    <div class="box" id="source">
        <h2>Source Content</h2>
        <p>This content will be copied to the target box.</p>
    </div>

    <button id="copy-button">Copy Content</button>

    <div class="box" id="target">
        <h2>Target Box</h2>
        <p>Copied content will appear here.</p>
    </div>

    <script src="day4.js"></script>
</body>
</html>


js

const source = document.getElementById("source");
const target = document.getElementById("target");
const copyButton = document.getElementById("copy-button");

copyButton.addEventListener("click", function() {
    target.innerHTML = source.innerHTML;

    console.log("Content copied successfully!");
});

// Bonus: Drag and drop
source.draggable = true;

source.addEventListener("dragstart", function(event) {
    event.dataTransfer.setData("text/plain", source.innerHTML);
});

target.addEventListener("dragover", function(event) {
    event.preventDefault();
});

target.addEventListener("drop", function(event) {
    event.preventDefault();

    const copiedContent = event.dataTransfer.getData("text/plain");

    target.innerHTML = copiedContent;
});
