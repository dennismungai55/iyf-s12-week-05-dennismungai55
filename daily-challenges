<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Image Remover</title>
</head>
<body>

    <h1>My Image Gallery</h1>

    <img src="https://placehold.co/200x150?text=Image+1" alt="First sample image">
    <img src="https://placehold.co/200x150?text=Image+2" alt="Second sample image">
    <img src="https://placehold.co/200x150?text=Image+3" alt="Third sample image">

    <br><br>

    <button id="remove-images">Remove Images</button>
    <button id="toggle-images">Hide / Show Images</button>

    <script src="day3.js"></script>
</body>
</html>


js

const removeButton = document.getElementById("remove-images");
const toggleButton = document.getElementById("toggle-images");

removeButton.addEventListener("click", function() {
    const images = document.querySelectorAll("img");

    images.forEach(function(image) {
        image.remove();
    });
});

toggleButton.addEventListener("click", function() {
    const images = document.querySelectorAll("img");

    images.forEach(function(image) {
        image.hidden = !image.hidden;
    });
});


